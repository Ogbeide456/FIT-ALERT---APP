# Firebase web app configuration (public values from Firebase Console).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Keep the RapidAPI secret server-side.
RAPIDAPI_KEY=
RAPIDAPI_HOST=exercisedb.p.rapidapi.com

# AI model provider: ollama (default) or openai.
AI_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Other Python-service integrations.
YOUTUBE_API_KEY=your_youtube_api_key_here
FITALERT_BACKEND_TOKEN=replace-with-the-same-long-random-secret-in-both-services

# Set in the Next.js server environment when Python runs on another host.
FITALERT_AI_BACKEND_URL=http://127.0.0.1:8000
